---
/**
 * Footer — è il "terzo step" di contatto.
 * Telefono (click-to-call), WhatsApp, email, social, Privacy & Cookie, P.IVA.
 */
import config from '../config';
import { contacts, viaggi, etichettaPartenze } from '../data/content';
import CurrentLine from './CurrentLine.astro';

const year = 2026; // anno fisso (no Date.now in build statico)
const { logoUrl } = config.assets;
// Nel footer elenchiamo i viaggi: è la stessa navigazione della vetrina.
const listaViaggi = viaggi;
---

<footer class="footer" aria-labelledby="footer-title">
  <CurrentLine variant="separator" class="footer__current" />

  <div class="container footer__inner">
    <div class="footer__brand">
      <img src={logoUrl} alt="Eddyline" width="150" height="44" class="footer__logo" />
      <p class="footer__tagline">
        Centro Sport Fluviali Valsesia. Dal 2001 accompagniamo persone in acqua, in forra
        e — da quest’anno — fuori dai confini.
      </p>
      <div class="footer__social" aria-label="Social">
        <a href={contacts.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="currentColor"
              d="M14 8.5h2.5V5.3h-2.6c-2.4 0-3.9 1.5-3.9 4v1.9H7.5v3.2h2.5V22h3.3v-7.6h2.5l.4-3.2h-2.9V9.5c0-.7.3-1 1.2-1z"
            ></path>
          </svg>
        </a>
        <a href={contacts.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              d="M7 3.5h10A3.5 3.5 0 0 1 20.5 7v10a3.5 3.5 0 0 1-3.5 3.5H7A3.5 3.5 0 0 1 3.5 17V7A3.5 3.5 0 0 1 7 3.5z"
            ></path>
            <circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.8"
            ></circle>
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"></circle>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h2 class="footer__h" id="footer-title">Contatti</h2>
      <ul class="footer__list">
        <li>
          <a class="footer__contact" href={contacts.phoneHref} data-track="call_click">
            <span class="footer__contact-label">Telefono</span>
            <span class="footer__contact-value">{contacts.phoneDisplay}</span>
          </a>
        </li>
        <li>
          <a
            class="footer__contact"
            href={contacts.whatsapp}
            target="_blank"
            rel="noopener"
            data-track="whatsapp_click"
          >
            <span class="footer__contact-label">WhatsApp</span>
            <span class="footer__contact-value">Scrivici un messaggio</span>
          </a>
        </li>
        <li>
          <a class="footer__contact" href={`mailto:${contacts.email}`}>
            <span class="footer__contact-label">Email</span>
            <span class="footer__contact-value">{contacts.email}</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__h">I viaggi</h2>
      <ul class="footer__list">
        {
          listaViaggi.map((v) =>
            v.pubblicato ? (
              <li>
                <a class="footer__contact" href={`/viaggi/${v.slug}`}>
                  <span class="footer__contact-label">{etichettaPartenze(v)}</span>
                  <span class="footer__contact-value">{v.nome}</span>
                </a>
              </li>
            ) : (
              <li>
                <span class="footer__contact-label">{etichettaPartenze(v)}</span>
                <span class="footer__contact-value footer__contact-value--soon">
                  {v.nome}
                </span>
              </li>
            )
          )
        }
      </ul>
    </div>
  </div>

  <div class="container footer__legal">
    <p>© {year} {contacts.legalName} — P.IVA {contacts.vat}</p>
    <a href={contacts.privacyUrl} target="_blank" rel="noopener">Privacy &amp; Cookie</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--granite);
    color: var(--text-on-dark);
    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0));
  }
  /* Sopra la sticky CTA mobile: spazio per non coprire il legale */
  @media (max-width: 719px) {
    .footer {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0));
    }
  }
  .footer__current {
    color: var(--sesia-bright);
    opacity: 0.5;
  }

  .footer__inner {
    display: grid;
    gap: clamp(1.75rem, 5vw, 3rem);
    padding-block: clamp(2.25rem, 6vw, 3.5rem);
  }
  @media (min-width: 760px) {
    .footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }

  .footer__logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    /* Il logo è pensato per fondo chiaro: lo schiariamo sul granite */
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }
  .footer__tagline {
    margin-top: 0.9rem;
    color: color-mix(in srgb, var(--foam) 68%, transparent);
    line-height: 1.6;
    max-width: 38ch;
    font-size: var(--step-0);
  }
  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: rgba(242, 246, 244, 0.08);
    color: var(--foam);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .footer__social a:hover {
    background: var(--sesia-bright);
    color: var(--granite);
    transform: translateY(-2px);
  }

  .footer__h {
    font-size: var(--step-1);
    color: var(--foam);
  }
  .footer__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .footer__list--plain li {
    color: var(--foam);
    font-weight: 500;
  }
  .footer__contact {
    display: grid;
    text-decoration: none;
    color: var(--foam);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__contact:hover {
    color: var(--sesia-bright);
  }
  .footer__contact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foam) 52%, transparent);
  }
  .footer__contact-value {
    font-weight: 600;
    margin-top: 0.1rem;
  }
  .footer__contact-value--soon {
    display: block;
    color: color-mix(in srgb, var(--foam) 60%, transparent);
  }

  .footer__cta {
    margin-top: 1.35rem;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(242, 246, 244, 0.12);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--foam) 55%, transparent);
  }
  .footer__legal a {
    color: color-mix(in srgb, var(--foam) 70%, transparent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer__legal a:hover {
    color: var(--sesia-bright);
  }
</style>
