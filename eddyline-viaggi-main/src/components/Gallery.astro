---
/**
 * Gallery — griglia masonry-like su fondo scuro, per far parlare le foto.
 * Nessun lightbox: la landing ha un solo obiettivo e il JS in più non paga.
 */
import type { Viaggio } from '../data/content';
import CurrentLine from './CurrentLine.astro';

interface Props {
  viaggio: Viaggio;
}
const { viaggio } = Astro.props;
const { gallery } = viaggio;
---

<section class="gal section" id="gallery" aria-labelledby="gal-title">
  <div class="container">
    <div class="gal__head reveal">
      <p class="eyebrow gal__eyebrow">L’ISOLA</p>
      <h2 class="gal__title" id="gal-title">Quello che vedrai</h2>
      <CurrentLine variant="underline" animate={true} class="gal__underline" />
    </div>

    <div class="gal__grid">
      {
        gallery.map((g) => (
          <figure class="gal__item reveal">
            <picture>
              <source type="image/webp" srcset={`/images/${g.img}-960.webp`} />
              <img
                src={`/images/${g.img}-960.jpg`}
                alt={g.alt}
                loading="lazy"
                decoding="async"
                width="960"
                height="720"
              />
            </picture>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gal {
    background: var(--granite);
    color: var(--text-on-dark);
  }
  .gal__head {
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
  }
  .gal__eyebrow {
    color: var(--sesia-bright);
  }
  .gal__title {
    color: var(--foam);
    font-size: var(--step-3);
    margin-top: 0.5rem;
  }
  .gal__underline {
    margin-inline: auto;
    color: var(--sesia-bright);
  }

  /* Griglia uniforme: 8 foto → 2 col × 4 righe, poi 4 col × 2 righe.
     Mai 3 colonne: con 8 elementi lascerebbe una riga incompleta. */
  .gal__grid {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (min-width: 760px) {
    .gal__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  .gal__item {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: rgba(242, 246, 244, 0.06);
  }
  /* Rapporto costante: tutte le celle allineate, nessun buco nella griglia. */
  .gal__item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .gal__item:hover img {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__item:hover img {
      transform: none;
    }
  }
</style>
