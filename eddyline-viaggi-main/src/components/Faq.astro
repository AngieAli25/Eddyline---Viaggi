---
/**
 * FAQ — accordion accessibile con <details>/<summary> nativi:
 * tastiera e screen reader gratis, funziona anche senza JS.
 */
import { contacts } from '../data/content';
import type { Viaggio } from '../data/content';
import CurrentLine from './CurrentLine.astro';

interface Props {
  viaggio: Viaggio;
}
const { viaggio } = Astro.props;
const { faqs } = viaggio;
---

<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="container container-narrow">
    <div class="faq__head reveal">
      <p class="eyebrow">DOMANDE FREQUENTI</p>
      <h2 class="faq__title" id="faq-title">Le risposte che cerchi prima di partire</h2>
      <CurrentLine variant="underline" animate={true} class="faq__underline" />
    </div>

    <div class="faq__list">
      {
        faqs.map((f) => (
          <details class="faq__item reveal" name="faq">
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    d="M12 5v14M5 12h14"
                  />
                </svg>
              </span>
            </summary>
            <div class="faq__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>

    <p class="faq__more reveal">
      Hai un’altra domanda?{' '}
      <a href={contacts.whatsapp} target="_blank" rel="noopener" data-track="whatsapp_click">
        Scrivici su WhatsApp
      </a>{' '}
      o chiama il{' '}
      <a href={contacts.phoneHref} data-track="call_click">{contacts.phoneDisplay}</a>.
    </p>
  </div>
</section>

<style>
  .faq__head {
    text-align: center;
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }
  .faq__title {
    font-size: var(--step-3);
    margin-top: 0.5rem;
    max-width: 24ch;
    margin-inline: auto;
  }
  .faq__underline {
    margin-inline: auto;
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
  }
  .faq__item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .faq__item[open] {
    border-color: var(--sesia-bright);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.95rem, 2.5vw, 1.2rem) clamp(1rem, 3vw, 1.4rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: var(--radius-pill);
    background: var(--sesia-bright-15);
    color: var(--sesia-deep);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 clamp(1rem, 3vw, 1.4rem) clamp(1.1rem, 2.5vw, 1.35rem);
  }
  .faq__a p {
    color: var(--text-mute);
    line-height: 1.65;
    max-width: 62ch;
  }

  .faq__more {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    text-align: center;
    color: var(--text-mute);
    font-size: var(--step-0);
  }
  .faq__more a {
    color: var(--sesia-deep);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sesia-bright);
    text-underline-offset: 3px;
  }
  .faq__more a:hover {
    color: var(--sesia-bright);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item[open] .faq__icon {
      transform: none;
    }
  }
</style>
